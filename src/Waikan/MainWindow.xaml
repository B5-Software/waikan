<Window x:Class="Waikan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Waikan.Views"
        mc:Ignorable="d"
        Title="这个词在外刊中"
        Icon="Assets/app.ico"
        Width="1180"
        Height="790"
        MinWidth="1020"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closing="OnWindowClosing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="226" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="17,24,17,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Orientation="Horizontal" Margin="5,0,0,28">
                    <Border Width="42"
                            Height="42"
                            CornerRadius="13">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#FFED6541" />
                                <GradientStop Offset="1" Color="#FFBE3623" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="外"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Microsoft YaHei UI"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="11,0,0,0">
                        <TextBlock Text="外刊计数"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="这个词在外刊中"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="工作台"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Margin="13,0,0,7" />
                    <RadioButton GroupName="Navigation"
                                 Style="{StaticResource NavRadioStyle}"
                                 Command="{Binding Commands.NavigateCommand}"
                                 CommandParameter="Today"
                                 IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Today}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" Style="{StaticResource IconTextStyle}" FontSize="16" />
                            <TextBlock Text="今天" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="Navigation"
                                 Style="{StaticResource NavRadioStyle}"
                                 Command="{Binding Commands.NavigateCommand}"
                                 CommandParameter="Records"
                                 IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Records}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" Style="{StaticResource IconTextStyle}" FontSize="16" />
                            <TextBlock Text="时间记录" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="Navigation"
                                 Style="{StaticResource NavRadioStyle}"
                                 Command="{Binding Commands.NavigateCommand}"
                                 CommandParameter="Settings"
                                 IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Settings}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource IconTextStyle}" FontSize="16" />
                            <TextBlock Text="设置" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="Navigation"
                                 Style="{StaticResource NavRadioStyle}"
                                 Command="{Binding Commands.NavigateCommand}"
                                 CommandParameter="About"
                                 IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=About}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" Style="{StaticResource IconTextStyle}" FontSize="16" />
                            <TextBlock Text="关于" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Live status -->
                <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="0,18,0,16">
                    <Border Style="{StaticResource SubtleCardBorderStyle}" Padding="14">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsListening}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasEngineError}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding EngineStateText}"
                                           Margin="8,0,0,0"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Grid>
                            <TextBlock Text="{Binding StatusDetail}"
                                       Style="{StaticResource TinyCaptionStyle}"
                                       Margin="0,5,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding StatusDetail}" />
                            <ProgressBar Style="{StaticResource LevelBarStyle}"
                                         Value="{Binding InputLevel, Mode=OneWay}"
                                         Margin="0,10,0,0"
                                         Opacity="{Binding IsListening, Converter={StaticResource BoolToOpacity}}" />
                            <Button Command="{Binding Commands.TogglePauseCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,10,0,0"
                                    Padding="10,6"
                                    HorizontalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding PauseButtonGlyph}" Style="{StaticResource IconTextStyle}" FontSize="12" />
                                    <TextBlock Text="{Binding PauseButtonText}" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding VersionText}"
                               Style="{StaticResource TinyCaptionStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9.5" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="本地离线 · 不上传音频" FontSize="9.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="4,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Tiny footer nav hint -->
                <StackPanel Grid.Row="3">
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,12" />
                    <TextBlock Text="关闭窗口后继续在托盘后台识别"
                               Style="{StaticResource TinyCaptionStyle}"
                               TextAlignment="Center"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="30,26,30,24">
            <views:TodayPage Visibility="{Binding CurrentPage, Converter={StaticResource EnumVisibility}, ConverterParameter=Today}" />
            <views:RecordsPage Visibility="{Binding CurrentPage, Converter={StaticResource EnumVisibility}, ConverterParameter=Records}" />
            <views:SettingsPage Visibility="{Binding CurrentPage, Converter={StaticResource EnumVisibility}, ConverterParameter=Settings}" />
            <views:AboutPage Visibility="{Binding CurrentPage, Converter={StaticResource EnumVisibility}, ConverterParameter=About}" />
        </Grid>
    </Grid>
</Window>
