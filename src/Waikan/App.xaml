<Application x:Class="Waikan.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Waikan.Infrastructure"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Waikan;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Waikan;component/Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <infra:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <infra:InverseBooleanConverter x:Key="InverseBool" />
            <infra:EnumEqualsConverter x:Key="EnumEquals" />
            <infra:EnumVisibilityConverter x:Key="EnumVisibility" />
            <infra:HexToBrushConverter x:Key="HexToBrush" />
            <infra:BooleanToOpacityConverter x:Key="BoolToOpacity" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
