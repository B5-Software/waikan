<UserControl x:Class="Waikan.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="720">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,4,0">
        <StackPanel>
            <Grid Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock Text="关于" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="一个只关心「外刊」这两个字的本地小工具。" Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
                <Border Style="{StaticResource BadgeBorderStyle}" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72E;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="11"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="离线运行" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" Margin="6,0,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Identity -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="28,26,28,26">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="54" Height="54" CornerRadius="16">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Offset="0" Color="#FFED6541" />
                                        <GradientStop Offset="1" Color="#FFBE3623" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="外"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Microsoft YaHei UI"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="White" />
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="15,0,0,0">
                                <TextBlock Text="这个词在外刊中" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding VersionText}" Style="{StaticResource TinyCaptionStyle}" Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="当麦克风里出现“外刊”，它就替你记下这一次。"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,18,0,0" />
                        <TextBlock Text="没有云端账户，没有音频上传，也没有把语音写进磁盘。只有本地 SQLite 里的一行时间记录。"
                                   Style="{StaticResource CaptionStyle}"
                                   Margin="0,8,0,0"
                                   MaxWidth="520" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Background="{DynamicResource AccentSoftBrush}"
                            Padding="24">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="本地关键词识别" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="sherpa-onnx" FontFamily="Segoe UI Variable Display" FontSize="27" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding ModelDescription}" Style="{StaticResource TinyCaptionStyle}" Margin="0,6,0,0" />
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,15,0,12" />
                            <TextBlock Text="{Binding PrivacyText}" Style="{StaticResource TinyCaptionStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Cards -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="数据与隐私" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="识别只依赖本机麦克风和本地模型。应用不包含网络请求代码，不会上传音频或文本。"
                                   Style="{StaticResource TinyCaptionStyle}"
                                   Margin="0,6,0,15" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="关键词" Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock Grid.Column="1" Text="外刊" Style="{StaticResource MetricValueStyle}" FontSize="12.5" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="音频源" Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock Grid.Column="1" Text="麦克风（可切换系统声音）" Style="{StaticResource MetricValueStyle}" FontSize="12.5" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="记录内容" Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock Grid.Column="1" Text="时间点 + 来源" Style="{StaticResource MetricValueStyle}" FontSize="12.5" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="数据目录" Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock Grid.Column="1" Text="%LOCALAPPDATA%\Waikan" Style="{StaticResource TinyCaptionStyle}" FontFamily="Cascadia Mono, Consolas" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="引擎与组件" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="全部在 CPU 上单线程运行，常驻几乎不占资源。"
                                   Style="{StaticResource TinyCaptionStyle}"
                                   Margin="0,6,0,15" />
                        <TextBlock Text="sherpa-onnx · KWS zh-en 3M int8" Style="{StaticResource MetricValueStyle}" FontSize="12.5" />
                        <TextBlock Text="Apache-2.0 · 本地离线关键词检测" Style="{StaticResource TinyCaptionStyle}" Margin="0,3,0,11" />
                        <TextBlock Text=".NET 10 · WPF" Style="{StaticResource MetricValueStyle}" FontSize="12.5" />
                        <TextBlock Text="Windows 桌面运行时 · MIT" Style="{StaticResource TinyCaptionStyle}" Margin="0,3,0,11" />
                        <TextBlock Text="NAudio · Microsoft.Data.Sqlite" Style="{StaticResource MetricValueStyle}" FontSize="12.5" />
                        <TextBlock Text="MIT / SQLite public domain" Style="{StaticResource TinyCaptionStyle}" Margin="0,3,0,0" />
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,13,0,10" />
                        <TextBlock Text="应用代码 · CC0-1.0" Style="{StaticResource MetricValueStyle}" FontSize="12.5" />
                        <TextBlock Text="github.com/B5-Software/waikan" Style="{StaticResource TinyCaptionStyle}" FontFamily="Cascadia Mono, Consolas" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Diagnostics and paths -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0" Padding="20">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="应用路径与诊断" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="排查麦克风、模型或数据问题时，把这些路径提供给维护者即可。"
                                       Style="{StaticResource TinyCaptionStyle}"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Command="{Binding Commands.CopyDiagnosticsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8C8;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="复制诊断信息" Margin="7,0,0,0" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Background="{DynamicResource InputBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14"
                            Margin="0,15,0,13">
                        <StackPanel>
                            <TextBlock Text="数据" Style="{StaticResource MetricLabelStyle}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding DataDirectory}" Style="{StaticResource MonoTimeStyle}" FontSize="11.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding DataDirectory}" />
                            <TextBlock Text="数据库" Style="{StaticResource MetricLabelStyle}" Margin="0,10,0,4" />
                            <TextBlock Text="{Binding DatabasePath}" Style="{StaticResource MonoTimeStyle}" FontSize="11.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding DatabasePath}" />
                            <TextBlock Text="日志" Style="{StaticResource MetricLabelStyle}" Margin="0,10,0,4" />
                            <TextBlock Text="{Binding LogDirectory}" Style="{StaticResource MonoTimeStyle}" FontSize="11.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding LogDirectory}" />
                            <TextBlock Text="模型" Style="{StaticResource MetricLabelStyle}" Margin="0,10,0,4" />
                            <TextBlock Text="{Binding ModelDirectory}" Style="{StaticResource MonoTimeStyle}" FontSize="11.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding ModelDirectory}" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ChipButtonStyle}" Command="{Binding Commands.OpenDataFolderCommand}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="打开数据目录" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ChipButtonStyle}" Command="{Binding Commands.OpenLogFolderCommand}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9F9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="打开日志目录" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ChipButtonStyle}" Command="{Binding Commands.OpenModelFolderCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="打开模型目录" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="《这个词在外刊中》· 数据永远留在这台电脑 · 源码以 CC0-1.0 开放"
                       Style="{StaticResource TinyCaptionStyle}"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,6" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
