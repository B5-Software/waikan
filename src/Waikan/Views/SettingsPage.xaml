<UserControl x:Class="Waikan.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="820">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,4,0">
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="识别、悬浮窗和后台行为都可以按你的习惯调整。更改会自动保存。"
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
                <Border Style="{StaticResource BadgeBorderStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsListening}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasEngineError}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusDetail}"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="7,0,0,0"
                                   MaxWidth="320"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recognition -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <StackPanel>
                            <TextBlock Text="语音识别" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="默认使用麦克风。只有听到「外刊」时才会计数。"
                                       Style="{StaticResource TinyCaptionStyle}"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                        <Border HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{DynamicResource SuccessSoftBrush}"
                                CornerRadius="10"
                                Padding="9,4">
                            <TextBlock Text="本地离线"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessBrush}" />
                        </Border>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,15,0,17" />

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="音频来源" Style="{StaticResource MetricValueStyle}" />
                            <TextBlock Text="{Binding SourceHint}" Style="{StaticResource TinyCaptionStyle}" Margin="0,4,20,0" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  Style="{StaticResource ComboBoxStyle}"
                                  ItemsSource="{Binding AudioSourceOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedSourceOption, Mode=TwoWay}" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="输入设备" Style="{StaticResource MetricValueStyle}" />
                            <TextBlock Text="插拔设备后会自动刷新并回退到系统默认。"
                                       Style="{StaticResource TinyCaptionStyle}"
                                       Margin="0,4,20,0" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  Style="{StaticResource ComboBoxStyle}"
                                  ItemsSource="{Binding AudioDevices}"
                                  DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedAudioDevice, Mode=TwoWay}"
                                  ToolTip="{Binding SelectedAudioDevice.Name}" />
                    </Grid>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="识别灵敏度" Style="{StaticResource MetricValueStyle}" />
                            <TextBlock Text="越靠右越容易触发；误报较多时向左调低。"
                                       Style="{StaticResource TinyCaptionStyle}"
                                       Margin="0,4,20,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Slider Style="{StaticResource SliderStyle}"
                                    Minimum="0"
                                    Maximum="100"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding Settings.DetectionSensitivity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Grid Margin="0,4,0,0">
                                <TextBlock Text="更严格" FontSize="9.5" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock HorizontalAlignment="Right" FontSize="9.5" Foreground="{DynamicResource TextTertiaryBrush}">
                                    <Run Text="{Binding Settings.DetectionSensitivity, Mode=OneWay}" />
                                    <Run Text=" / 100" />
                                </TextBlock>
                                <TextBlock Text="更灵敏" FontSize="9.5" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="识别状态" Style="{StaticResource MetricValueStyle}" />
                            <TextBlock Text="{Binding StatusDetail}"
                                       Style="{StaticResource TinyCaptionStyle}"
                                       Margin="0,4,20,0"
                                       TextWrapping="Wrap"
                                       MaxWidth="500" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding Commands.TogglePauseCommand}"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding PauseButtonGlyph}" Style="{StaticResource IconTextStyle}" FontSize="12" />
                                <TextBlock Text="{Binding PauseButtonText}" Margin="7,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2"
                                Content="重启引擎"
                                Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding Commands.RestartEngineCommand}"
                                Margin="0,0,4,0" />
                        <Button Grid.Column="3"
                                Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding Commands.OpenMicrophoneSettingsCommand}"
                                ToolTip="打开 Windows 设置 → 隐私和安全性 → 麦克风">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72E;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="11"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="麦克风权限" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Overlay -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="屏幕悬浮窗" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="始终置顶在屏幕右上角，只显示当天累计数字；无背景、无附加文字，点击穿透、不抢焦点。"
                               Style="{StaticResource TinyCaptionStyle}"
                               Margin="0,5,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="300" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Grid Margin="0,8,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="显示悬浮窗" Style="{StaticResource MetricValueStyle}" />
                                    <TextBlock Text="关闭后仍会在后台识别，数字可在主界面查看。"
                                               Style="{StaticResource TinyCaptionStyle}" Margin="0,4,20,0" />
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          Style="{StaticResource SwitchCheckBoxStyle}"
                                          IsChecked="{Binding Settings.OverlayEnabled, Mode=TwoWay}" />
                            </Grid>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="数字颜色" Style="{StaticResource MetricValueStyle}" />
                                    <TextBlock Text="{Binding Settings.OverlayTextColor}"
                                               Style="{StaticResource TinyCaptionStyle}"
                                               FontFamily="Cascadia Mono, Consolas"
                                               Margin="0,4,20,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ItemsControl ItemsSource="{Binding PresetOverlayColors}" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Width="25"
                                                        Height="25"
                                                        Padding="0"
                                                        Margin="0,0,6,0"
                                                        Background="{Binding Converter={StaticResource HexToBrush}}"
                                                        BorderBrush="{DynamicResource BorderStrongBrush}"
                                                        BorderThickness="1"
                                                        Cursor="Hand"
                                                        ToolTip="{Binding}"
                                                        Command="{Binding DataContext.Commands.SetOverlayPresetColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="8" />
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding Commands.PickOverlayColorCommand}"
                                            Padding="10,6"
                                            Margin="4,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE771;"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="11"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="自定义" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="数字大小" Style="{StaticResource MetricValueStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Settings.OverlayFontSize, StringFormat={}{0:F0} px}"
                                           Style="{StaticResource TinyCaptionStyle}"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <Slider Style="{StaticResource SliderStyle}"
                                    Minimum="12"
                                    Maximum="240"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding Settings.OverlayFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Margin="0,0,0,4" />
                            <Grid>
                                <TextBlock Text="12 px" FontSize="9.5" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="240 px" FontSize="9.5" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>

                        <!-- Preview -->
                        <Border Grid.Column="1"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="18"
                                Margin="24,0,0,0">
                            <StackPanel>
                                <TextBlock Text="悬浮窗预览" Style="{StaticResource MetricLabelStyle}" HorizontalAlignment="Center" />
                                <Border Background="#10151D"
                                        CornerRadius="12"
                                        Margin="0,10,0,0"
                                        Height="138"
                                        ClipToBounds="True">
                                    <Grid>
                                        <Viewbox Stretch="Uniform" MaxHeight="112" MaxWidth="248" Margin="18">
                                            <TextBlock Text="{Binding TodayCount}"
                                                       FontFamily="Segoe UI Variable Display, Microsoft YaHei UI"
                                                       FontSize="{Binding Settings.OverlayFontSize}"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding OverlayPreviewTextBrush}">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect BlurRadius="7"
                                                                      ShadowDepth="1"
                                                                      Direction="270"
                                                                      Opacity="0.42"
                                                                      Color="#000000" />
                                                </TextBlock.Effect>
                                            </TextBlock>
                                        </Viewbox>
                                    </Grid>
                                </Border>
                                <TextBlock Text="仅数字，无背景、无附加文字。深色底仅用于预览。"
                                           Style="{StaticResource TinyCaptionStyle}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Startup -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="启动与后台" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="登录 Windows 后自动在后台开始识别，不显示主窗口。"
                               Style="{StaticResource TinyCaptionStyle}"
                               Margin="0,5,0,14" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="开机自动启动" Style="{StaticResource MetricValueStyle}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,20,0">
                                <TextBlock Text="加入当前用户启动项 · " Style="{StaticResource TinyCaptionStyle}" />
                                <TextBlock Text="{Binding AutoStartStateText}" Style="{StaticResource TinyCaptionStyle}" Foreground="{DynamicResource SuccessBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  Style="{StaticResource SwitchCheckBoxStyle}"
                                  IsChecked="{Binding Settings.StartWithWindows, Mode=TwoWay}" />
                    </Grid>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="关闭主窗口时缩到托盘" Style="{StaticResource MetricValueStyle}" />
                            <TextBlock Text="推荐开启。关闭窗口后识别仍会继续，双击托盘图标返回界面。"
                                       Style="{StaticResource TinyCaptionStyle}" Margin="0,4,20,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  Style="{StaticResource SwitchCheckBoxStyle}"
                                  IsChecked="{Binding Settings.MinimizeToTrayOnClose, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Padding="18,14" Margin="0,0,0,4">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="识别引擎、数据目录和许可证信息在“关于”页面。"
                                   Style="{StaticResource TinyCaptionStyle}"
                                   Margin="9,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            Style="{StaticResource GhostButtonStyle}"
                            Padding="10,4"
                            Content="打开关于"
                            Command="{Binding Commands.NavigateCommand}"
                            CommandParameter="About" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
